---
import { site, withBase } from "../data";
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="brand">
    <span class="glyph" style="font-size:20px;">&#964;</span>
    <span class="name">baldric</span>
  </div>
  <div class="l">
    <a href={withBase("/")}>Home</a>
    <a href={withBase("/tutorials/quickstart/")}>Docs</a>
    <a href={withBase("/explanation/architecture/")}>Architecture</a>
    <a href={withBase("/releases/")}>Releases</a>
    <a href={withBase("/roadmap/")}>Roadmap</a>
    <a href={site.githubUrl}>GitHub</a>
    <a
      class="footer-hf"
      href="https://huggingface.co"
      target="_blank"
      rel="noopener"
      aria-label="Hugging Face"
      title="Hugging Face"
    >
      <img
        class="hf-logo"
        src={withBase("/images/huggingface-logo.svg")}
        alt="Hugging Face"
        width="16"
        height="15"
        loading="lazy"
      />
      <span>Hugging Face</span>
    </a>
  </div>
  <span
    >An educational project &middot; inspired by <a
      href="https://pi.dev"
      target="_blank"
      rel="noopener">Pi</a
    ></span
  >
</footer>
